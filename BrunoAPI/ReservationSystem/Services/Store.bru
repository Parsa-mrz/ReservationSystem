meta {
  name: Store
  type: http
  seq: 2
}

post {
  url: {{businessesUrl}}/{{businessId}}/services
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Hair Cut",
    "duration": 45,
    "buffer_time": 10,
    "price": 25
  }
}

script:post-response {
  
  // 1. Grab the raw body
  const rawBody = res.getBody();
  
  // 2. Parse the body safely
  let parsedBody = rawBody;
  if (typeof rawBody === 'string') {
    try {
      parsedBody = JSON.parse(rawBody);
    } catch (e) {
      console.error("[ERROR] Failed to parse body as JSON.", e.message);
    }
  }
  
  // 3. Dig into the structure
  if (parsedBody && parsedBody.data) {
    
    if (parsedBody.data.service && parsedBody.data.service.id) {
      const id = parsedBody.data.service.id;
      
      try {
        bru.setVar("serviceId", id);
      } catch (err) {
        console.error("[ERROR] Could not set Collection variable:", err.message);
      }
  
      try {
        bru.setEnvVar("serviceId", id);
      } catch (err) {
        console.error("[ERROR] Could not set Environment variable:", err.message);
      }
  
    } else {
      console.error("[ERROR] The 'data' object exists, but 'token' is missing inside it.");
    }
  } else {
    console.error("[ERROR] The 'data' object is missing from the parsed body altogether.");
  }
}

settings {
  encodeUrl: true
}
